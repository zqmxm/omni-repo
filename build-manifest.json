{
  "_说明": "新软件只需在这里加一条，auto-backup.yml 就会自动构建并备份到独立 Release",
  "_命名铁律": "name 必须与软件真实名字完全一致（中文软件就用中文名），dir 用同名子目录，产物文件也用软件名。禁止用英文代号代替软件本名。",
  "_字段": {
    "name": "软件本名（软件叫什么就写什么，支持中文，如 透明橡皮擦）",
    "dir": "项目目录（相对仓库根，与 name 同名）",
    "kind": "python-exe | go-exe | android | node | web",
    "artifact": "产物文件名或相对路径（用软件名，如 透明橡皮擦.exe）",
    "runner": "可选，windows-latest 或 ubuntu-latest"
  },
  "apps": [
    {
      "name": "透明橡皮擦",
      "dir": "desktop/透明橡皮擦",
      "kind": "python-exe",
      "artifact": "透明橡皮擦.exe",
      "runner": "windows-latest",
      "ascii_name": "toumingxiangpicao"
    },
    {
      "name": "自动抠图",
      "dir": "android/自动抠图",
      "kind": "android",
      "artifact": "自动抠图.apk",
      "runner": "ubuntu-latest",
      "ascii_name": "zidongkoutu"
    },
    {
      "name": "自动操作助手",
      "dir": "desktop/自动操作助手",
      "kind": "go-exe",
      "artifact": "自动操作助手.exe",
      "runner": "windows-latest",
      "ascii_name": "zidongcaozuozhushou"
    },
    {
      "name": "批量替换助手",
      "dir": "desktop/批量替换助手",
      "kind": "go-exe",
      "artifact": "批量替换助手.exe",
      "runner": "windows-latest",
      "ascii_name": "piliangtihuanzhushou",
      "manual_release": true
    }
  ],
  "_手动归档说明": "manual_release=true 的软件：源码入库、专属 workflow 出 Artifact，但不进 auto-backup 矩阵；成品 exe 由人工核对后挂固定 Release"
}
